{
  "manifestVersion": 3,
  "package": {
    "id": "discordsrv_helper",
    "version": "3.0.0",
    "publisher": "M12Labs",
    "license": "MIT",
    "homepage": "https://github.com/macery12/M12Labs-Extensions"
  },
  "extension": {
    "id": "discordsrv_helper",
    "name": "DiscordSRV Helper",
    "description": "Install and configure DiscordSRV from M12Labs, including token, channel, history, and subuser access controls. The plugin jar is fetched from the official DiscordSRV release feed and verified by the panel before it reaches your server.",
    "icon": "discordsrv",
    "defaults": {
      "enabled": false,
      "allowedNests": [],
      "allowedEggs": [],
      "settings": {}
    }
  },
  "compatiblePanelVersions": [
    ">=Alpha 4.0 <Alpha 5.0"
  ],
  "capabilities": {
    "routes": {
      "client": true
    },
    "pages": {
      "server": [
        {
          "slug": "discordsrv",
          "labelKey": "ext.discordsrv_helper.nav.discordsrv",
          "icon": "discordsrv",
          "category": "configuration",
          "order": 50,
          "requiredServerPermission": "extension.read"
        }
      ]
    }
  },
  "requirements": {
    "phpExtensions": ["zip"],
    "panelServices": ["http-client"],
    "extensions": []
  }
}
