{
  "manifestVersion": 3,
  "package": {
    "id": "custom_domains",
    "version": "1.0.2",
    "publisher": "M12Labs",
    "license": "MIT",
    "homepage": "https://github.com/macery12/M12Labs-Extensions"
  },
  "extension": {
    "id": "custom_domains",
    "name": "Custom Domains",
    "description": "Offer branded subdomains on domains you curate. Server owners map a subdomain to an allocation and the panel provisions the real Cloudflare DNS records for it.",
    "icon": "globe",
    "defaults": {
      "enabled": false,
      "allowedNests": [],
      "allowedEggs": [],
      "settings": {
        "cloudflare_proxied": false,
        "cloudflare_retries": 3,
        "cloudflare_retry_sleep_ms": 250,
        "allow_wildcard": false,
        "max_wildcards_per_user": 1
      }
    }
  },
  "compatiblePanelVersions": [
    ">=Alpha 4.0 <Alpha 5.0"
  ],
  "capabilities": {
    "routes": {
      "client": true,
      "admin": true
    },
    "pages": {
      "server": [
        {
          "slug": "domains",
          "labelKey": "ext.custom_domains.nav.server",
          "icon": "globe",
          "category": "configuration",
          "order": 40,
          "requiredServerPermission": "allocation.*"
        }
      ],
      "admin": [
        {
          "slug": "domains",
          "labelKey": "ext.custom_domains.nav.admin",
          "icon": "globe",
          "category": "modules",
          "order": 30,
          "requiredExtensionPermission": "read"
        }
      ]
    },
    "permissions": {
      "admin": [
        {
          "key": "read",
          "labelKey": "ext.custom_domains.permission.read",
          "descriptionKey": "ext.custom_domains.permission.read.description"
        },
        {
          "key": "create",
          "labelKey": "ext.custom_domains.permission.create",
          "descriptionKey": "ext.custom_domains.permission.create.description"
        },
        {
          "key": "update",
          "labelKey": "ext.custom_domains.permission.update",
          "descriptionKey": "ext.custom_domains.permission.update.description"
        },
        {
          "key": "delete",
          "labelKey": "ext.custom_domains.permission.delete",
          "descriptionKey": "ext.custom_domains.permission.delete.description",
          "dangerous": true
        }
      ]
    },
    "database": {
      "migrations": true,
      "tables": [
        "ext_custom_domains_domains",
        "ext_custom_domains_api_keys",
        "ext_custom_domains_server_domains",
        "ext_custom_domains_dns_logs"
      ]
    },
    "hooks": [
      {
        "event": "server.pre_delete",
        "handler": "CleanupServerDomains",
        "mode": "synchronous_best_effort",
        "timeoutMs": 5000
      }
    ],
    "queues": [
      {
        "name": "dns",
        "maxAttempts": 5,
        "timeoutSeconds": 120,
        "backoffSeconds": [
          10,
          60,
          300
        ],
        "rateLimit": "60/minute",
        "maxConcurrent": 4,
        "maxOutstanding": 5000
      }
    ],
    "secrets": [
      {
        "key": "cloudflare_token",
        "labelKey": "ext.custom_domains.secret.cloudflareToken",
        "helpKey": "ext.custom_domains.secret.cloudflareToken.help",
        "rotatable": true
      }
    ],
    "settings": {
      "fields": [
        {
          "key": "cloudflare_proxied",
          "type": "boolean",
          "labelKey": "ext.custom_domains.setting.proxied",
          "helpKey": "ext.custom_domains.setting.proxied.help",
          "default": false
        },
        {
          "key": "cloudflare_retries",
          "type": "number",
          "labelKey": "ext.custom_domains.setting.retries",
          "helpKey": "ext.custom_domains.setting.retries.help",
          "required": true,
          "default": 3,
          "min": 0,
          "max": 10
        },
        {
          "key": "cloudflare_retry_sleep_ms",
          "type": "number",
          "labelKey": "ext.custom_domains.setting.retrySleep",
          "helpKey": "ext.custom_domains.setting.retrySleep.help",
          "required": true,
          "default": 250,
          "min": 0,
          "max": 10000
        },
        {
          "key": "allow_wildcard",
          "type": "boolean",
          "labelKey": "ext.custom_domains.setting.allowWildcard",
          "helpKey": "ext.custom_domains.setting.allowWildcard.help",
          "default": false
        },
        {
          "key": "max_wildcards_per_user",
          "type": "number",
          "labelKey": "ext.custom_domains.setting.maxWildcards",
          "helpKey": "ext.custom_domains.setting.maxWildcards.help",
          "required": true,
          "default": 1,
          "min": 0,
          "max": 100
        }
      ]
    }
  },
  "requirements": {
    "panelServices": [
      "http-client",
      "queue",
      "secrets",
      "hooks"
    ],
    "extensions": []
  }
}
