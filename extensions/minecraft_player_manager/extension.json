{
  "manifestVersion": 3,
  "package": {
    "id": "minecraft_player_manager",
    "version": "3.0.0",
    "publisher": "M12Labs",
    "license": "MIT",
    "homepage": "https://github.com/macery12/M12Labs-Extensions"
  },
  "extension": {
    "id": "minecraft_player_manager",
    "name": "Minecraft Player Manager",
    "description": "Manage Minecraft Java Edition players directly from M12Labs with whitelist, operator, ban, kick, inventory, and attribute tools.",
    "icon": "players",
    "defaults": {
      "enabled": false,
      "allowedNests": [],
      "allowedEggs": [],
      "settings": {}
    }
  },
  "compatiblePanelVersions": [
    ">=Alpha 4.0 <Alpha 5.0"
  ],
  "capabilities": {
    "routes": {
      "client": true
    },
    "pages": {
      "server": [
        {
          "slug": "players",
          "labelKey": "ext.minecraft_player_manager.nav.players",
          "icon": "players",
          "category": "general",
          "order": 10,
          "requiredServerPermission": "file.read-content"
        }
      ]
    }
  },
  "requirements": {
    "phpExtensions": ["zlib"],
    "panelServices": ["http-client"],
    "extensions": []
  }
}
