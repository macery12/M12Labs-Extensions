{
  "manifestVersion": 3,
  "package": {
    "id": "minecraft_startup_editor",
    "version": "3.0.0",
    "publisher": "M12Labs",
    "license": "MIT",
    "homepage": "https://github.com/macery12/M12Labs-Extensions"
  },
  "extension": {
    "id": "minecraft_startup_editor",
    "name": "Minecraft Startup Editor",
    "description": "Safely configure your Minecraft server startup with curated presets and individual addon options. Supports Forge, Fabric, NeoForge, Paper, Purpur, Vanilla and more. No arbitrary command input — all options are validated against a secure server-side allowlist.",
    "icon": "wrench",
    "defaults": {
      "enabled": false,
      "allowedNests": [1],
      "allowedEggs": [],
      "settings": {}
    }
  },
  "compatiblePanelVersions": [
    ">=Alpha 4.0 <Alpha 5.0"
  ],
  "capabilities": {
    "routes": {
      "client": true
    },
    "pages": {
      "server": [
        {
          "slug": "startup",
          "labelKey": "ext.minecraft_startup_editor.nav.startup",
          "icon": "wrench",
          "category": "configuration",
          "order": 20,
          "requiredServerPermission": "startup.read"
        }
      ]
    }
  },
  "requirements": {
    "phpExtensions": [],
    "panelServices": [],
    "extensions": []
  }
}
