{
  "manifestVersion": 3,
  "package": {
    "id": "minecraft_log_uploader",
    "version": "3.0.0",
    "publisher": "M12Labs",
    "license": "MIT",
    "homepage": "https://github.com/macery12/M12Labs-Extensions"
  },
  "extension": {
    "id": "minecraft_log_uploader",
    "name": "Minecraft Log Uploader",
    "description": "Read and preview your Minecraft server logs, and optionally publish one to the third-party mclo.gs paste service for sharing.",
    "icon": "docs",
    "defaults": {
      "enabled": false,
      "allowedNests": [1],
      "allowedEggs": [],
      "settings": {}
    }
  },
  "compatiblePanelVersions": [
    ">=Alpha 4.0 <Alpha 5.0"
  ],
  "capabilities": {
    "routes": {
      "client": true
    },
    "pages": {
      "server": [
        {
          "slug": "logs",
          "labelKey": "ext.minecraft_log_uploader.nav.logs",
          "icon": "docs",
          "category": "data",
          "order": 40,
          "requiredServerPermission": "file.read"
        }
      ]
    }
  },
  "requirements": {
    "phpExtensions": ["zlib"],
    "panelServices": ["http-client"],
    "extensions": []
  }
}
