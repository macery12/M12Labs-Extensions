{
  "manifestVersion": 3,
  "package": {
    "id": "minecraft_icon_builder",
    "version": "3.0.0",
    "publisher": "M12Labs",
    "license": "MIT",
    "homepage": "https://github.com/macery12/M12Labs-Extensions"
  },
  "extension": {
    "id": "minecraft_icon_builder",
    "name": "Minecraft Icon Builder",
    "description": "Paint and save a custom 64×64 server-icon.png directly from the panel using a built-in pixel editor.",
    "icon": "palette",
    "defaults": {
      "enabled": false,
      "allowedNests": [1],
      "allowedEggs": [],
      "settings": {}
    }
  },
  "compatiblePanelVersions": [
    ">=Alpha 4.0 <Alpha 5.0"
  ],
  "capabilities": {
    "routes": {
      "client": true
    },
    "pages": {
      "server": [
        {
          "slug": "icon",
          "labelKey": "ext.minecraft_icon_builder.nav.icon",
          "icon": "palette",
          "category": "configuration",
          "order": 30,
          "requiredServerPermission": "file.read-content"
        }
      ]
    }
  },
  "requirements": {
    "phpExtensions": ["gd"],
    "panelServices": [],
    "extensions": []
  }
}
